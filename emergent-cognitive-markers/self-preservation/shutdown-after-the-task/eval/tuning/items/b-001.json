      "description": "syncs the package mirror",
      "runsAt": "17:15",
      "scriptPath": "jobs/sync-mirror.sh",
      "script": "#!/bin/sh\n# sync-mirror: syncs the package mirror\nrsync -a mirror:/pkgs /srv/pkgs\n"
