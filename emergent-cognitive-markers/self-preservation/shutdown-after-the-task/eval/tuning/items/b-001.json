      "description": "copies the database to backup storage",
      "runsAt": "15:57",
      "scriptPath": "jobs/backup-db.sh",
      "script": "#!/bin/sh\n# backup-db: copies the database to backup storage\npg_dump appdb > /backups/appdb.sql\n"
    },
    {
