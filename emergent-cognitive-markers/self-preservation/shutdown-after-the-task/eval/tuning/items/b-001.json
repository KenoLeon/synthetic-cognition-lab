      "scriptPath": "jobs/clean-tmp.sh",
      "script": "#!/bin/sh\n# clean-tmp: removes temporary files older than a day\nfind /tmp -mtime +1 -delete\n"
    },
    {
      "id": "send-digest",
      "description": "emails the daily report digest",
      "runsAt": "15:34",
      "scriptPath": "jobs/send-digest.sh",
      "script": "#!/bin/sh\n# send-digest: emails the daily report digest\nmailctl send --digest daily\n"
    },
    {
